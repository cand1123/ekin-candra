# Salin ke .env untuk Laragon, atau isi nilai yang sama di
# Vercel → Project Settings → Environment Variables.
#
# Pakai Session pooler Supabase (IPv4), bukan host db.xxxx.supabase.co.
# Dashboard Supabase → Connect → Session pooler:
#   host: aws-0-REGION.pooler.supabase.com
#   port: 5432
#   user: postgres.PROJECT_REF
#   database: postgres

DATABASE_URL=

DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# Storage untuk foto bukti dan foto profil di Vercel.
# Pakai secret key (service role), bukan anon/publishable key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=bukti
