{
  "version": 2,
  "installCommand": "echo skip-node-install",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0",
      "excludeFiles": "{node_modules/**,.agents/**,.trae/**,docs/**,.git/**}"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
